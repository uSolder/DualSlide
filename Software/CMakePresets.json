{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DS_PLATFORM": "windows"
            }
        },
        {
            "name": "embedded-debug",
            "displayName": "STM32H7A3 Debug",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DS_PLATFORM": "embedded"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "embedded-debug",
            "configurePreset": "embedded-debug"
        }
    ]
}